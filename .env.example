# API meteorológica
WEATHER_ENDPOINT=https://api.open-meteo.com/v1/forecast

# Localidades: config/locations.json
# Ciclo: argumento obrigatório --cycle-date AAAA-MM-DD
# Variáveis meteorológicas e unidades: definidas no código conforme o contrato.

# Ambiente Docker/Airflow: preencher somente no .env local.
POSTGRES_AIRFLOW_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=

# Banco meteorológico: acesso pela rede interna do Compose.
WEATHER_DB_HOST=postgres
WEATHER_DB_PORT=5432
WEATHER_DB_NAME=weather
WEATHER_DB_USER=weather_app
WEATHER_DB_PASSWORD=
