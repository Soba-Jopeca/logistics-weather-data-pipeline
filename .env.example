WEATHER_ENDPOINT=https://api.open-meteo.com/v1/forecast
WEATHER_CITY=Campinas
WEATHER_LATITUDE=-22.9056
WEATHER_LONGITUDE=-47.0608
WEATHER_TIMEZONE=America/Sao_Paulo
WEATHER_FORECAST_HOURS=24
WEATHER_HOURLY=temperature_2m,precipitation,wind_speed_10m
WEATHER_TEMPERATURE_UNIT=celsius
WEATHER_WIND_SPEED_UNIT=kmh
WEATHER_PRECIPITATION_UNIT=mm
# Ambiente Docker/Airflow: preencher somente no .env local.
POSTGRES_AIRFLOW_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=